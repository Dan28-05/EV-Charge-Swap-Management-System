# Copy to .env for local Docker Compose. .env is ignored by Git.
POSTGRES_PASSWORD=replace-with-a-local-development-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Optional: when set, the API creates or promotes the first Admin after migrations run.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_FULL_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
